@page "/admin/lines"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ManagerOrAdmin")]
@layout AndonApp.Components.Layout.AdminLayout
@using AndonApp.Data
@using AndonApp.Data.Models
@inject IDbContextFactory<AndonDbContext> DbFactory
@inject NavigationManager Nav
@rendermode InteractiveServer

<PageTitle>Production Lines – Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Production Lines</h1>
        <button class="btn btn-primary" @onclick="() => OpenModal(null)">+ New Line</button>
    </div>

    @if (_lines == null)
    {
        <p>Loading...</p>
    }
    else if (!_lines.Any())
    {
        <p class="empty-state">No production lines configured.</p>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Slug</th>
                    <th>Active</th>
                    <th>End-User URL</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in _lines)
                {
                    var lineUrl = $"{Nav.BaseUri}line/{line.Slug}?token={line.AccessToken}";
                    <tr>
                        <td><strong>@line.Name</strong></td>
                        <td>
                            @if (line.LineType != null)
                            {
                                <span class="badge badge-blue">@line.LineType.Name</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td><code>@line.Slug</code></td>
                        <td>
                            <span class="badge @(line.IsActive ? "badge-green" : "badge-gray")">
                                @(line.IsActive ? "Active" : "Inactive")
                            </span>
                        </td>
                        <td>
                            <div class="url-cell">
                                <code class="url-text">@lineUrl</code>
                                <a href="@lineUrl" target="_blank" class="btn-icon btn-icon-primary" title="Open production line screen">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                                    </svg>
                                </a>
                            </div>
                        </td>
                        <td>
                            <div class="action-btns">
                                <a href="/admin/lines/@line.Id/schedule" class="btn-icon" title="Schedule">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                    </svg>
                                </a>
                                <a href="/admin/lines/@line.Id/targets" class="btn-icon" title="Targets">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <circle cx="12" cy="12" r="9" /><circle cx="12" cy="12" r="5" /><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
                                    </svg>
                                </a>
                                <a href="/admin/lines/@line.Id/review" class="btn-icon" title="Review">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
                                    </svg>
                                </a>
                                <button class="btn-icon" title="Edit" @onclick="() => OpenModal(line)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                    </svg>
                                </button>
                                <button class="btn-icon btn-icon-danger" title="Delete" @onclick="() => ConfirmDelete(line)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                    </svg>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@if (_showModal)
{
    <div class="modal-backdrop" @onclick="CloseModal">
        <div class="modal" @onclick:stopPropagation>
            <div class="modal-header">
                <h2>@(_editing == null ? "New Production Line" : "Edit Production Line")</h2>
                <button class="modal-close" @onclick="CloseModal">&times;</button>
            </div>
            <div class="modal-body">
                @if (!string.IsNullOrEmpty(_modalError))
                {
                    <div class="alert alert-error">@_modalError</div>
                }
                <div class="form-group">
                    <label>Name *</label>
                    <input class="form-control" @bind="_form.Name" placeholder="e.g. Line A" maxlength="100"
                           @oninput="AutoSlug" />
                </div>
                <div class="form-group">
                    <label>Slug * <small>(URL-safe, unique)</small></label>
                    <input class="form-control" @bind="_form.Slug" placeholder="e.g. line-a" maxlength="100" />
                    <small class="help-text">Used in the URL: /line/<em>@_form.Slug</em></small>
                </div>
                <div class="form-group">
                    <label>Line Type</label>
                    <select class="form-control" @bind="_form.LineTypeId">
                        <option value="0">— None —</option>
                        @foreach (var type in _lineTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Pool <small>(ERP pool identifier, optional)</small></label>
                    <input class="form-control" @bind="_form.Pool" placeholder="e.g. POOL-A" maxlength="100" />
                    <small class="help-text">Matches the Pool column returned by the ERP query to populate the BUILT card.</small>
                </div>
                <div class="form-group form-check">
                    <input type="checkbox" id="lineActive" @bind="_form.IsActive" />
                    <label for="lineActive">Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="CloseModal">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveLine" disabled="@_saving">
                    @(_saving ? "Saving..." : "Save")
                </button>
            </div>
        </div>
    </div>
}

@if (_deleteTarget != null)
{
    <div class="modal-backdrop">
        <div class="modal modal-sm">
            <div class="modal-header">
                <h2>Delete Production Line</h2>
            </div>
            <div class="modal-body">
                <p>Delete <strong>@_deleteTarget.Name</strong>? This cannot be undone.</p>
                @if (!string.IsNullOrEmpty(_deleteError))
                {
                    <div class="alert alert-error">@_deleteError</div>
                }
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" @onclick="() => _deleteTarget = null">Cancel</button>
                <button class="btn btn-danger" @onclick="DeleteLine">Delete</button>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductionLine>? _lines;
    private List<LineType> _lineTypes = new();
    private bool _showModal;
    private ProductionLine? _editing;
    private LineForm _form = new();
    private string? _modalError;
    private bool _saving;
    private ProductionLine? _deleteTarget;
    private string? _deleteError;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _lines = await db.ProductionLines
            .Include(l => l.LineType)
            .OrderBy(l => l.Name)
            .ToListAsync();
        _lineTypes = await db.LineTypes.OrderBy(t => t.Name).ToListAsync();
    }

    private void OpenModal(ProductionLine? line)
    {
        _editing = line;
        _form = line == null
            ? new LineForm()
            : new LineForm { Name = line.Name, Slug = line.Slug, IsActive = line.IsActive, Pool = line.Pool, LineTypeId = line.LineTypeId ?? 0 };
        _modalError = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _editing = null;
        _modalError = null;
    }

    private void AutoSlug(ChangeEventArgs e)
    {
        if (_editing != null) return; // Don't auto-slug on edit
        var name = e.Value?.ToString() ?? "";
        _form.Name = name;
        _form.Slug = System.Text.RegularExpressions.Regex.Replace(
            name.ToLowerInvariant().Trim(), @"[^a-z0-9]+", "-").Trim('-');
    }

    private async Task SaveLine()
    {
        if (string.IsNullOrWhiteSpace(_form.Name) || string.IsNullOrWhiteSpace(_form.Slug))
        {
            _modalError = "Name and Slug are required.";
            return;
        }

        var slug = _form.Slug.Trim().ToLower();
        if (!System.Text.RegularExpressions.Regex.IsMatch(slug, @"^[a-z0-9\-]+$"))
        {
            _modalError = "Slug must contain only lowercase letters, numbers and hyphens.";
            return;
        }

        _saving = true;
        _modalError = null;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (_editing == null)
            {
                if (await db.ProductionLines.AnyAsync(l => l.Slug == slug))
                {
                    _modalError = $"Slug '{slug}' already exists.";
                    return;
                }
                db.ProductionLines.Add(new ProductionLine
                {
                    Name = _form.Name.Trim(),
                    Slug = slug,
                    AccessToken = Guid.NewGuid().ToString("N") + Guid.NewGuid().ToString("N"),
                    IsActive = _form.IsActive,
                    Pool = string.IsNullOrWhiteSpace(_form.Pool) ? null : _form.Pool.Trim(),
                    LineTypeId = _form.LineTypeId == 0 ? null : _form.LineTypeId
                });
            }
            else
            {
                if (await db.ProductionLines.AnyAsync(l => l.Slug == slug && l.Id != _editing.Id))
                {
                    _modalError = $"Slug '{slug}' already exists.";
                    return;
                }
                var entity = await db.ProductionLines.FindAsync(_editing.Id);
                if (entity != null)
                {
                    entity.Name = _form.Name.Trim();
                    entity.Slug = slug;
                    entity.IsActive = _form.IsActive;
                    entity.Pool = string.IsNullOrWhiteSpace(_form.Pool) ? null : _form.Pool.Trim();
                    entity.LineTypeId = _form.LineTypeId == 0 ? null : _form.LineTypeId;
                }
            }

            await db.SaveChangesAsync();
            CloseModal();
            await LoadAsync();
        }
        finally
        {
            _saving = false;
        }
    }

    private void ConfirmDelete(ProductionLine line)
    {
        _deleteTarget = line;
        _deleteError = null;
    }

    private async Task DeleteLine()
    {
        if (_deleteTarget == null) return;
        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Incidents.AnyAsync(i => i.ProductionLineId == _deleteTarget.Id))
        {
            _deleteError = "Cannot delete: incidents exist for this line.";
            return;
        }
        var entity = await db.ProductionLines.FindAsync(_deleteTarget.Id);
        if (entity != null) db.ProductionLines.Remove(entity);
        await db.SaveChangesAsync();
        _deleteTarget = null;
        await LoadAsync();
    }

    private class LineForm
    {
        public string Name { get; set; } = string.Empty;
        public string Slug { get; set; } = string.Empty;
        public bool IsActive { get; set; } = true;
        public string? Pool { get; set; }
        public int LineTypeId { get; set; } = 0;
    }
}

@page "/admin/schedule-adherence"
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "ManagerOrAdmin")]
@layout AndonApp.Components.Layout.AdminLayout
@using AndonApp.Data
@using AndonApp.Data.Models
@using AndonApp.Services
@using Microsoft.Extensions.Options
@using System.Globalization
@inject IDbContextFactory<AndonDbContext> DbFactory
@inject IErpDataService ErpDataService
@inject IOptionsMonitor<ErpSettings> ErpOptions
@rendermode InteractiveServer

<PageTitle>Schedule Adherence – Admin</PageTitle>

<div class="admin-page">
    <div class="page-header">
        <h1>Schedule Adherence</h1>
    </div>

    <div class="adh-controls">
        <div class="adh-week-nav">
            <button class="btn btn-secondary btn-sm" @onclick="PrevWeek">&#8592; Prev</button>
            <span class="adh-week-label">@WeekLabel</span>
            <button class="btn btn-secondary btn-sm" @onclick="NextWeek">Next &#8594;</button>
        </div>

        @if (_allTypes.Any() || _hasUntypedLines)
        {
            <div class="adh-type-chips">
                <span class="adh-chips-label">Show:</span>
                @foreach (var lt in _allTypes)
                {
                    var isChecked = _selectedTypeIds.Contains(lt.Id);
                    <label class="overview-filter-chip @(isChecked ? "active" : "")">
                        <input type="checkbox" checked="@isChecked"
                               @onchange="e => ToggleType(lt.Id, (bool)e.Value!)" />
                        @lt.Name
                    </label>
                }
                @if (_hasUntypedLines)
                {
                    <label class="overview-filter-chip @(_showUntyped ? "active" : "")">
                        <input type="checkbox" checked="@_showUntyped"
                               @onchange="e => _showUntyped = (bool)e.Value!" />
                        Untyped
                    </label>
                }
                <button class="btn btn-sm btn-secondary" @onclick="SelectAll">All</button>
                <button class="btn btn-sm btn-secondary" @onclick="ClearAll">None</button>
            </div>
        }
    </div>

    @if (!_erpHistoryAvailable)
    {
        <div class="alert alert-error">
            ERP historical build query is not configured — Built quantities will not be shown.
            Configure at <a href="/admin/erp-settings">Admin &rarr; ERP Settings</a>.
        </div>
    }

    @if (_loading)
    {
        <p>Loading...</p>
    }
    else
    {
        var groups = VisibleGroups.ToList();
        @if (!groups.Any())
        {
            <p class="empty-state">No active production lines match the selected filter.</p>
        }
        else
        {
            <div class="table-scroll">
                <table class="adh-table">
                    <thead>
                        <tr>
                            <th class="adh-line-col">Production Line</th>
                            @foreach (var day in WeekDays)
                            {
                                <th class="adh-day-col @(day == Today ? "adh-day-today" : "")">
                                    <span class="adh-day-name">@day.ToString("ddd")</span>
                                    <span class="adh-day-date">@day.ToString("dd MMM")</span>
                                </th>
                            }
                            <th class="adh-week-col">Week</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in groups)
                        {
                            <tr class="adh-group-header">
                                <td colspan="9">@(group.TypeName ?? "Untyped")</td>
                            </tr>

                            @foreach (var line in group.Lines)
                            {
                                var showErpLine = _erpHistoryAvailable && line.Pool != null;
                                <tr>
                                    <td class="adh-line-name-cell"><strong>@line.Name</strong></td>

                                    @foreach (var day in WeekDays)
                                    {
                                        var t = GetTarget(line.Id, day);
                                        var b = showErpLine ? GetBuilt(line.Pool!, day) : null;
                                        var p = CalcPct(t, b);
                                        <td class="adh-cell @GetCellBg(p, t)">
                                            @RenderCell(t, b, p, showErpLine)
                                        </td>
                                    }

                                    @{ var wt = LineWeekTarget(line); var wb = LineWeekBuilt(line); var wp = CalcPct(wt, wb); }
                                    <td class="adh-cell adh-week-cell @GetCellBg(wp, wt)">
                                        @RenderCell(wt, wb, wp, showErpLine)
                                    </td>
                                </tr>
                            }

                            <tr class="adh-totals-row">
                                <td class="adh-totals-label">@(group.TypeName ?? "Untyped") Total</td>

                                @foreach (var day in WeekDays)
                                {
                                    var dt = DayTargetTotal(group.Lines, day);
                                    var db = DayBuiltTotal(group.Lines, day);
                                    var dp = CalcPct(dt, db);
                                    <td class="adh-cell adh-totals-cell @GetCellBg(dp, dt)">
                                        @RenderCell(dt, db, dp, _erpHistoryAvailable)
                                    </td>
                                }

                                @{ var gwt = WeekTargetTotal(group.Lines); var gwb = WeekBuiltTotal(group.Lines); var gwp = CalcPct(gwt, gwb); }
                                <td class="adh-cell adh-week-cell adh-totals-cell @GetCellBg(gwp, gwt)">
                                    @RenderCell(gwt, gwb, gwp, _erpHistoryAvailable)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="adh-legend">
                <span class="adh-legend-label">Key:</span>
                <span class="adh-legend-item"><span class="adh-pct-pill adh-pct-green">&#8805; 100%</span> On / above target</span>
                <span class="adh-legend-item"><span class="adh-pct-pill adh-pct-amber">80–99%</span> Slightly below</span>
                <span class="adh-legend-item"><span class="adh-pct-pill adh-pct-red">&lt; 80%</span> Significantly below</span>
            </div>
        }
    }
</div>

@code {
    private DateOnly _weekStart = GetWeekMonday(DateOnly.FromDateTime(DateTime.Today));

    private List<ProductionLine> _allLines = new();
    private List<LineType> _allTypes = new();
    private HashSet<int> _selectedTypeIds = new();
    private bool _showUntyped = true;
    private bool _hasUntypedLines;

    private Dictionary<(int LineId, DateOnly Date), int> _targets = new();
    private Dictionary<(string Pool, DateOnly Date), int> _builtByPoolDate = new();
    private bool _loading = true;
    private bool _erpHistoryAvailable;

    private DateOnly Today => DateOnly.FromDateTime(DateTime.Today);
    private List<DateOnly> WeekDays => Enumerable.Range(0, 7).Select(i => _weekStart.AddDays(i)).ToList();

    private string WeekLabel
    {
        get
        {
            var end = _weekStart.AddDays(6);
            var wk = ISOWeek.GetWeekOfYear(_weekStart.ToDateTime(TimeOnly.MinValue));
            return $"{_weekStart:dd MMM} – {end:dd MMM yyyy}  (Week {wk})";
        }
    }

    private IEnumerable<LineGroup> VisibleGroups =>
        _allLines
            .Where(l => l.LineTypeId == null ? _showUntyped : _selectedTypeIds.Contains(l.LineTypeId.Value))
            .GroupBy(l => new { l.LineTypeId, TypeName = l.LineType?.Name })
            .OrderBy(g => g.Key.TypeName == null ? "￿" : g.Key.TypeName)
            .Select(g => new LineGroup
            {
                TypeId   = g.Key.LineTypeId,
                TypeName = g.Key.TypeName,
                Lines    = g.OrderBy(l => l.Name).ToList()
            });

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _allTypes = await db.LineTypes.OrderBy(t => t.Name).ToListAsync();
        _selectedTypeIds = _allTypes.Select(t => t.Id).ToHashSet();
        await LoadAsync();
    }

    private async Task PrevWeek() { _weekStart = _weekStart.AddDays(-7); await LoadAsync(); }
    private async Task NextWeek() { _weekStart = _weekStart.AddDays(7);  await LoadAsync(); }

    private void ToggleType(int id, bool on) { if (on) _selectedTypeIds.Add(id); else _selectedTypeIds.Remove(id); }
    private void SelectAll() { _selectedTypeIds = _allTypes.Select(t => t.Id).ToHashSet(); _showUntyped = true; }
    private void ClearAll()  { _selectedTypeIds.Clear(); _showUntyped = false; }

    private async Task LoadAsync()
    {
        _loading = true;
        StateHasChanged();

        var settings = ErpOptions.CurrentValue;
        _erpHistoryAvailable = settings.Enabled && !string.IsNullOrWhiteSpace(settings.HistoryQuery);

        var weekEnd  = _weekStart.AddDays(6);
        var weekDays = WeekDays;

        await using var db = await DbFactory.CreateDbContextAsync();

        _allLines = await db.ProductionLines
            .Include(l => l.LineType)
            .Where(l => l.IsActive)
            .OrderBy(l => l.Name)
            .ToListAsync();

        _hasUntypedLines = _allLines.Any(l => l.LineTypeId == null);

        var lineIds = _allLines.Select(l => l.Id).ToList();

        var targetList = await db.LineTargets
            .Where(t => lineIds.Contains(t.ProductionLineId)
                     && t.Date >= _weekStart && t.Date <= weekEnd)
            .ToListAsync();

        _targets = targetList.ToDictionary(t => (t.ProductionLineId, t.Date), t => t.Target);

        _builtByPoolDate = new();
        if (_erpHistoryAvailable)
        {
            try
            {
                var allPoints = await ErpDataService.FetchBuildHistoryAsync();
                _builtByPoolDate = allPoints
                    .Where(p => weekDays.Contains(DateOnly.FromDateTime(p.Timestamp.ToLocalTime())))
                    .GroupBy(p => (p.Pool, DateOnly.FromDateTime(p.Timestamp.ToLocalTime())))
                    .ToDictionary(g => g.Key, g => g.Sum(p => p.Quantity));
            }
            catch { /* silently degrade — cells show "–" */ }
        }

        _loading = false;
    }

    // ---- Data helpers ----

    private int? GetTarget(int lineId, DateOnly date)
        => _targets.TryGetValue((lineId, date), out var t) ? t : null;

    private int? GetBuilt(string pool, DateOnly date)
        => _builtByPoolDate.TryGetValue((pool, date), out var b) ? b : null;

    private static double? CalcPct(int? target, int? built)
    {
        if (!target.HasValue || target.Value <= 0 || !built.HasValue) return null;
        return (double)built.Value / target.Value * 100.0;
    }

    // ---- Aggregation helpers ----

    private int? LineWeekTarget(ProductionLine line)
    {
        var vals = WeekDays.Select(d => GetTarget(line.Id, d)).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        return vals.Count > 0 ? vals.Sum() : null;
    }

    private int? LineWeekBuilt(ProductionLine line)
    {
        if (!_erpHistoryAvailable || line.Pool == null) return null;
        var vals = WeekDays.Select(d => GetBuilt(line.Pool, d)).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        return vals.Count > 0 ? vals.Sum() : null;
    }

    private int? DayTargetTotal(IList<ProductionLine> lines, DateOnly day)
    {
        var vals = lines.Select(l => GetTarget(l.Id, day)).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        return vals.Count > 0 ? vals.Sum() : null;
    }

    private int? DayBuiltTotal(IList<ProductionLine> lines, DateOnly day)
    {
        if (!_erpHistoryAvailable) return null;
        var vals = lines.Where(l => l.Pool != null).Select(l => GetBuilt(l.Pool!, day)).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        return vals.Count > 0 ? vals.Sum() : null;
    }

    private int? WeekTargetTotal(IList<ProductionLine> lines)
    {
        var vals = WeekDays.SelectMany(d => lines.Select(l => GetTarget(l.Id, d))).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        return vals.Count > 0 ? vals.Sum() : null;
    }

    private int? WeekBuiltTotal(IList<ProductionLine> lines)
    {
        if (!_erpHistoryAvailable) return null;
        var vals = WeekDays.SelectMany(d => lines.Where(l => l.Pool != null).Select(l => GetBuilt(l.Pool!, d))).Where(v => v.HasValue).Select(v => v!.Value).ToList();
        return vals.Count > 0 ? vals.Sum() : null;
    }

    // ---- CSS helpers ----

    private static string GetCellBg(double? pct, int? target)
    {
        if (!target.HasValue) return "adh-cell-notarget";
        if (!pct.HasValue)    return "";
        if (pct.Value >= 100) return "adh-cell-bg-green";
        if (pct.Value >= 80)  return "adh-cell-bg-amber";
        return "adh-cell-bg-red";
    }

    private static string GetPctClass(double pct)
    {
        if (pct >= 100) return "adh-pct-green";
        if (pct >= 80)  return "adh-pct-amber";
        return "adh-pct-red";
    }

    // ---- Render fragment ----

    private RenderFragment RenderCell(int? target, int? built, double? pct, bool showErp) => __builder =>
    {
        int seq = 0;
        if (showErp || target.HasValue)
        {
            __builder.OpenElement(seq++, "div");
            __builder.AddAttribute(seq++, "class", "adh-fraction");
            __builder.AddContent(seq++, showErp
                ? $"{(built.HasValue ? built.Value.ToString("N0") : "–")} / {(target.HasValue ? target.Value.ToString("N0") : "–")}"
                : target!.Value.ToString("N0"));
            __builder.CloseElement();

            if (pct.HasValue)
            {
                __builder.OpenElement(seq++, "div");
                __builder.AddAttribute(seq++, "class", $"adh-pct-pill {GetPctClass(pct.Value)}");
                __builder.AddContent(seq++, $"{pct.Value:F0}%");
                __builder.CloseElement();
            }
        }
        else
        {
            __builder.OpenElement(seq++, "span");
            __builder.AddAttribute(seq++, "class", "adh-no-data");
            __builder.AddContent(seq++, "—");
            __builder.CloseElement();
        }
    };

    private static DateOnly GetWeekMonday(DateOnly date)
    {
        var dow = (int)date.DayOfWeek;
        return date.AddDays(dow == 0 ? -6 : -(dow - 1));
    }

    private class LineGroup
    {
        public int? TypeId   { get; set; }
        public string? TypeName { get; set; }
        public List<ProductionLine> Lines { get; set; } = new();
    }
}

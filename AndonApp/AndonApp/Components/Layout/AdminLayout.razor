@inherits LayoutComponentBase
@using AndonApp.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Options
@inject AuthenticationStateProvider AuthStateProvider
@inject IOptionsMonitor<GeneralSettings> GeneralOptions

<div class="admin-shell">
    <nav class="admin-nav">

        <div class="admin-nav-brand">@BrandName</div>

        <div class="admin-nav-links">

            <NavLink class="admin-nav-link" href="/admin/overview" Match="NavLinkMatch.Prefix">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
                Overview
            </NavLink>

            <NavLink class="admin-nav-link" href="/admin/andon-codes" Match="NavLinkMatch.Prefix">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                ANDON Codes
            </NavLink>

            <NavLink class="admin-nav-link" href="/admin/lines" Match="NavLinkMatch.Prefix">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                Lines
            </NavLink>

            <NavLink class="admin-nav-link" href="/admin/line-types" Match="NavLinkMatch.Prefix">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16"/></svg>
                Line Types
            </NavLink>

            <NavLink class="admin-nav-link" href="/admin/todays-targets" Match="NavLinkMatch.Prefix">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="5"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/></svg>
                Targets
            </NavLink>

            <NavLink class="admin-nav-link" href="/admin/andon-history" Match="NavLinkMatch.Prefix">
                <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                History
            </NavLink>

            @if (_isAdmin)
            {
                <span class="nav-sep"></span>

                <NavLink class="admin-nav-link" href="/admin/email-settings" Match="NavLinkMatch.Prefix">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    Email
                </NavLink>

                <NavLink class="admin-nav-link" href="/admin/erp-settings" Match="NavLinkMatch.Prefix">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12H3m2 0a9 9 0 1018 0 9 9 0 00-18 0zm9-4v1m0 6v1M8.05 8.05l.707.707M15.95 15.95l.707.707M15.95 8.05l-.707.707M8.757 15.243l-.707.707"/></svg>
                    ERP
                </NavLink>

                <NavLink class="admin-nav-link" href="/admin/users" Match="NavLinkMatch.Prefix">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                    Users
                </NavLink>

                <NavLink class="admin-nav-link" href="/admin/general-settings" Match="NavLinkMatch.Prefix">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                    Settings
                </NavLink>
            }
        </div>

        <div class="admin-nav-right">
            <button class="theme-toggle" onclick="andonTheme.toggle()" title="Toggle dark mode"></button>
            <span class="admin-nav-user">
                <svg width="13" height="13" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
                @_username
            </span>
            <form method="post" action="/admin/logout" @formname="logout-form">
                <AntiforgeryToken />
                <button type="submit" class="admin-nav-logout" title="Sign out">
                    <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                    Sign Out
                </button>
            </form>
        </div>

    </nav>
    <main class="admin-main">
        @Body
    </main>
</div>

@code {
    private bool _isAdmin;
    private string _username = string.Empty;

    private string BrandName
    {
        get
        {
            var company = GeneralOptions.CurrentValue.CompanyName;
            return string.IsNullOrWhiteSpace(company) ? "ANDON" : company;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        _isAdmin   = state.User.IsInRole("Admin");
        _username  = state.User.Identity?.Name ?? string.Empty;
    }
}
